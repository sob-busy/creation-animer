# ──────────────────────────────────────────────────────────────
# StyliZ — variables d'environnement
# Copiez ce fichier en .env.local (jamais commité) et remplissez-le.
# Sur Vercel : Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# URL publique de l'application (liens d'e-mail, redirections OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Dashboard → Project Settings → API) ─────────────
# Publiques : exposées au navigateur, protégées par RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt

# SECRÈTE — contourne le RLS. Serveur uniquement (webhooks, tâches admin).
# Ne JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Dashboard → Developers → API keys / Webhooks) ─────
# SECRÈTES — serveur uniquement.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
